---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import WritingItem from "@/components/WritingItem.astro";

const allPosts = await getCollection("writing");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Writing | Ujaan Das">
  <div class="flex flex-col gap-8 mt-8">
    <div class="flex flex-col gap-4">
      <h1
        class="text-2xl font-bold tracking-tight text-zinc-700 dark:text-zinc-300"
      >
        Writing
      </h1>
      <p class="text-lg leading-7 text-zinc-600 dark:text-zinc-400">
        Blog posts, half-finished thoughts, and the occasional rant.
      </p>
    </div>

    <div class="flex flex-col">
      {
        sortedPosts.map((item) => (
          <WritingItem
            title={item.data.title}
            date={item.data.date}
            href={`/writing/${item.id}`}
            body={item.body}
          />
        ))
      }
    </div>
  </div>
</Layout>
