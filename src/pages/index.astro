---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Ujaan Das">
  <section class="mt-16 flex flex-col gap-6">
    <h1
      class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-5xl"
    >
      Hey, I'm Ujaan!
    </h1>

    <p class="text-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
      I like building stuff when I should probably be studying.
    </p>
    <p class="text-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
      I'm currently a post-grad student at the University of Warwick, where I'm
      writing my dissertation on the applicability of formal methods to LLM
      outputs.
    </p>
    <p class="text-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
      I'm interested in all things frontend, backend and AI. In my spare time, I
      work on my homelab and read about compilers.
    </p>
    <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      (I also really like Nix!)
    </p>
  </section>

  <div class="mt-4 flex gap-6">
    <a
      href="https://github.com"
      target="_blank"
      class="text-sm font-medium text-zinc-900 hover:text-zinc-500 dark:text-zinc-200 dark:hover:text-zinc-400 transition-colors"
    >
      GitHub &rarr;
    </a>
    <a
      href="https://linkedin.com"
      target="_blank"
      class="text-sm font-medium text-zinc-900 hover:text-zinc-500 dark:text-zinc-200 dark:hover:text-zinc-400 transition-colors"
    >
      LinkedIn &rarr;
    </a>
  </div>
</Layout>
