---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import meImage from "@/assets/me.webp";
import Link from "@/components/Link.astro";
import { getCollection } from "astro:content";
import Section from "@/components/Section.astro";
import WorkItem from "@/components/WorkItem.astro";
import PostItem from "@/components/PostItem.astro";
import ProjectItem from "@/components/ProjectItem.astro";

const posts = await getCollection("posts");
const projects = await getCollection("projects");
---

<Layout title="Ujaan Das">
  <section class="flex flex-col gap-4 sm:gap-8">
    <div class="flex flex-col sm:flex-row sm:items-baseline gap-6">
      <Image
        src={meImage}
        alt="Me!"
        loading="eager"
        class="w-32 h-32 sm:w-42 sm:h-42"
      />
      <Link href="/me">
        <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">
          Hey, I'm Ujaan!
        </h1>
      </Link>
    </div>

    <div class="flex flex-col gap-5">
      <p
        class="text-xl sm:text-2xl leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        I like building stuff when I should probably be studying.
      </p>
      <p
        class="text-xl sm:text-2xl leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        I'm currently a post-grad student at the University of Warwick, where
        I'm writing my dissertation on the applicability of formal methods to
        LLM outputs.
      </p>
      <p
        class="text-xl sm:text-2xl leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        I'm interested in all things frontend, backend and AI. In my spare time,
        I work on my homelab and read about compilers.
      </p>
      <p
        class="text-base leading-relaxed text-zinc-500 dark:text-zinc-400 mt-2 italic"
      >
        (I also really like Nix!)
      </p>
    </div>
  </section>

  <Section title="Experience">
    <div class="flex flex-col gap-8">
      <WorkItem
        company="Tech Company Name"
        role="Backend Engineer"
        date="Aug 2024 — Present"
      >
        Maintained and scaled high-throughput microservices using Go and
        PostgreSQL.
      </WorkItem>

      <WorkItem
        company="Cool Startup"
        role="Software Engineering Intern"
        date="May 2023 — Aug 2023"
      >
        Built an internal LLM tooling dashboard using Next.js, Tailwind, and
        tRPC.
      </WorkItem>
    </div>
  </Section>

  <Section title="Recent Writing" linkText="See all →" linkHref="/blog">
    <div class="flex flex-col gap-4">
      <PostItem
        title="Verifying LLM outputs with formal methods"
        date="Oct 24"
        href="/blog/formal-methods"
      />
      <PostItem
        title="Why I switched my entire homelab to NixOS"
        date="Sep 12"
        href="/blog/nixos-homelab"
      />
    </div>
  </Section>

  <Section title="Projects" linkText="See all →" linkHref="/projects">
    <div
      class="grid grid-flow-col auto-cols-70 sm:auto-cols-80 gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden *:snap-start"
    >
      <ProjectItem
        title="Nix Homelab"
        description="Declarative infrastructure for my personal servers."
        href="https://github.com/ujaandas/nix-config"
      />

      <ProjectItem
        title="Toy Compiler"
        description="A lightweight compiler built in Go from scratch. Includes an AST viewer and custom lexer."
        href="https://github.com/ujaandas/toy-compiler"
      />

      <ProjectItem
        title="LLM Evaluator"
        description="A testing suite for evaluating the deterministic properties of local LLMs."
        href="https://github.com/ujaandas/llm-eval"
      />
    </div>
  </Section>

  <Section title="Get in touch">
    <div class="flex flex-col gap-4">
      <p class="text-zinc-700 dark:text-zinc-300">
        Always happy to chat! You can find my resume and socials below:
      </p>

      <div class="flex flex-wrap items-center gap-6 sm:gap-8 mt-2">
        <Link href="mailto:ujaandas03@gmail.com">Email</Link>

        <Link
          href="https://raw.githubusercontent.com/ujaandas/oojresume/refs/heads/main/out/UjaanDasResumeBackend.pdf"
          external
        >
          Resume
        </Link>
        <Link href="https://github.com/ujaandas/" external>GitHub</Link>
        <Link href="https://linkedin.com/in/ujaandas/" external>LinkedIn</Link>
      </div>
    </div>
  </Section>

  <footer
    class="mt-20 pb-32 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400"
  >
    <p>&copy; {new Date().getFullYear()} Ujaan Das</p>

    <Link
      href="https://github.com/ujaandas/ujaandas.github.io"
      external
      class="text-sm"
    >
      View Source
    </Link>
  </footer>
</Layout>
