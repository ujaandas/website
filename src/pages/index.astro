---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import meImage from "@/assets/me.webp";
import Link from "@/components/Link.astro";
---

<Layout title="Ujaan Das">
  <section class="flex flex-col gap-4 sm:gap-8">
    <div class="flex flex-col sm:flex-row sm:items-baseline gap-6">
      <Image
        src={meImage}
        alt="Me!"
        loading="eager"
        class="w-32 h-32 sm:w-42 sm:h-42"
      />
      <Link href="/me">
        <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">
          Hey, I'm Ujaan!
        </h1>
      </Link>
    </div>

    <div class="flex flex-col gap-5">
      <p
        class="text-xl sm:text-2xl leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        I like building stuff when I should probably be studying.
      </p>
      <p
        class="text-xl sm:text-2xl leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        I'm currently a post-grad student at the University of Warwick, where
        I'm writing my dissertation on the applicability of formal methods to
        LLM outputs.
      </p>
      <p
        class="text-xl sm:text-2xl leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        I'm interested in all things frontend, backend and AI. In my spare time,
        I work on my homelab and read about compilers.
      </p>
      <p
        class="text-base leading-relaxed text-zinc-500 dark:text-zinc-400 mt-2 italic"
      >
        (I also really like Nix!)
      </p>
    </div>
  </section>

  <div class="mt-8 flex gap-6">
    <Link href="https://github.com/ujaandas/" external>GitHub</Link>
    <Link href="https://linkedin.com/in/ujaandas/" external>LinkedIn</Link>
  </div>
</Layout>
