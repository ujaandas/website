---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home | My Portfolio">
  <section class="mt-16 flex flex-col gap-6">
    <h1
      class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-5xl"
    >
      Software engineer, writer, and creator.
    </h1>

    <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      I'm a developer building things on the internet. This is my personal slice
      of the web where I share my projects, thoughts, and what I'm learning
      right now.
    </p>

    <div class="mt-4 flex gap-6">
      <a
        href="https://github.com"
        target="_blank"
        class="text-sm font-medium text-zinc-900 hover:text-zinc-500 dark:text-zinc-200 dark:hover:text-zinc-400 transition-colors"
      >
        GitHub &rarr;
      </a>
      <a
        href="https://linkedin.com"
        target="_blank"
        class="text-sm font-medium text-zinc-900 hover:text-zinc-500 dark:text-zinc-200 dark:hover:text-zinc-400 transition-colors"
      >
        LinkedIn &rarr;
      </a>
    </div>
  </section>
</Layout>
