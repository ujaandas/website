---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/Prose.astro";
import meImage from "@/assets/me.webp";

const page = await getEntry("pages", "me");

if (!page) {
  throw new Error("About Me page content not found in src/content/pages/me");
}

const { Content } = await render(page);
---

<Layout title="Ujaan Das">
  <div class="flex flex-col gap-16">
    <section class="flex flex-col gap-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-6">
        <Image src={meImage} alt="Me!" loading="eager" class="w-32 h-32" />
        <h1
          class="text-2xl font-bold tracking-tight leading-tight text-zinc-700 dark:text-zinc-300"
        >
          Hey, I'm Ujaan!
        </h1>
      </div>

      <Prose>
        <Content />
      </Prose>
    </section>
  </div>
</Layout>
