---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import WorkItem from "@/components/WorkItem.astro";

const allWork = await getCollection("work");
const sortedWork = allWork.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<Layout title="Work Experience | Ujaan Das">
  <main class="flex flex-col gap-8 sm:gap-12 mt-8">
    <h1 class="text-3xl font-bold tracking-tight sm:text-3xl">
      Work Experience
    </h1>

    <div class="flex flex-col gap-8">
      {
        sortedWork.map((item) => (
          <WorkItem
            company={item.data.company}
            role={item.data.role}
            startDate={item.data.startDate}
            endDate={item.data.endDate}
          >
            {item.body}
          </WorkItem>
        ))
      }
    </div>
  </main>
</Layout>
