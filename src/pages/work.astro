---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import WorkItem from "@/components/WorkItem.astro";

const allWork = await getCollection("work");
const sortedWork = allWork.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<Layout title="Work Experience | Ujaan Das">
  <div class="flex flex-col gap-8 mt-8">
    <div class="flex flex-col gap-4">
      <h1
        class="text-2xl font-bold tracking-tight text-zinc-700 dark:text-zinc-300"
      >
        Work Experience
      </h1>
      <p class="text-lg leading-7 text-zinc-600 dark:text-zinc-400">
        Where I've worked, and what I actually did there.
      </p>
    </div>

    <div class="flex flex-col">
      {
        sortedWork.map(async (item, i) => {
          const { Content } = await render(item);

          return (
            <WorkItem
              company={item.data.company}
              role={item.data.role}
              startDate={item.data.startDate}
              endDate={item.data.endDate}
              isLast={i === sortedWork.length - 1}
              showTimeline
            >
              <Content />
            </WorkItem>
          );
        })
      }
    </div>
  </div>
</Layout>
