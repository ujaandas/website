---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import WorkItem from "@/components/WorkItem.astro";

const allWork = await getCollection("work");
const sortedWork = allWork.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<Layout title="Work Experience | Ujaan Das">
  <main class="flex flex-col gap-8 mt-8">
    <h1 class="text-2xl font-bold tracking-tight">Work Experience</h1>

    <div class="flex flex-col gap-12">
      {
        sortedWork.map(async (item) => {
          const { Content } = await render(item);

          return (
            <WorkItem
              company={item.data.company}
              role={item.data.role}
              startDate={item.data.startDate}
              endDate={item.data.endDate}
            >
              <Content />
            </WorkItem>
          );
        })
      }
    </div>
  </main>
</Layout>
