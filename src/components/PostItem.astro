---
interface Props {
  title: string;
  date: Date;
  href: string;
}

const { title, date, href } = Astro.props;

const format = (d: Date | "Present") => {
  if (d === "Present") return d;
  return d.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    day: "2-digit",
  });
};

const dateString = format(date);
---

<a
  href={href}
  class="group flex justify-between items-center py-2 border-b border-zinc-200 dark:border-zinc-800"
>
  <span
    class="text-zinc-800 dark:text-zinc-200 group-hover:text-blue-600 transition-colors"
  >
    {title}
  </span>
  <span class="text-zinc-500 text-sm shrink-0">
    {dateString}
  </span>
</a>
