---
interface Props {
  company: string;
  role: string;
  startDate: Date;
  endDate: Date | "Present";
}

const { company, role, startDate, endDate } = Astro.props;

const format = (d: Date | "Present") => {
  if (d === "Present") return d;
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

const dateString = `${format(startDate)} – ${format(endDate)}`;
---

<div class="flex flex-col gap-2">
  <div
    class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4"
  >
    <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
      {company}
      <span class="text-zinc-500 dark:text-zinc-400 font-normal text-base"
        >/ {role}</span
      >
    </h3>
    <span class="text-sm text-zinc-500 dark:text-zinc-400 shrink-0">
      {dateString}
    </span>
  </div>
  <p class="text-zinc-700 dark:text-zinc-300">
    <slot />
  </p>
</div>
